# Preferred Miniflux settings.
MINIFLUX_URL=https://miniflux.example.com
MINIFLUX_USERNAME=
MINIFLUX_PASSWORD=

# Optional token auth. If set, this is used instead of username/password.
# The root .env compatibility alias TOKEN is also supported.
MINIFLUX_TOKEN=

# Worker limits.
SKIMMER_FETCH_LIMIT=100
SKIMMER_DATA_DIR=./data

# Destructive Miniflux writeback is off by default. When enabled, Skimmer marks
# entries classified as ignore as read in Miniflux.
SKIMMER_WRITE_BACK=false

# Bind address for the HTTP API/UI. Inside Docker this must stay 0.0.0.0;
# restrict exposure at the host level (compose maps it to 127.0.0.1).
SKIMMER_HOST=127.0.0.1
SKIMMER_PORT=8765

# Cheap local keyword rules, comma-separated.
SKIMMER_MUST_READ_KEYWORDS=
SKIMMER_POSSIBLE_INTEREST_KEYWORDS=
SKIMMER_IGNORE_KEYWORDS=
